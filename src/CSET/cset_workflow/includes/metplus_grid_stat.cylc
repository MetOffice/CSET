{% if RUN_METPLUS_GRID_STAT|default(False) %}
[scheduling]
    [[graph]]
    {% macro metplus_grid_stat_graph() %}
        {% for model in models %}
            fetch_fcst_m{{model["id"]}} => \
            metplus_grid_stat_m{{model["id"]}} => \
            metplus_grid_stat_postproc_m{{model["id"]}} => \
            cycle_complete
        {% endfor %}
    {% endmacro %}

    {% if CSET_CYCLING_MODE == "case_study" %}
        {% for date in CSET_CASE_DATES %}
            R1/{{date}} = """
                    {{metplus_grid_stat_graph()}}
                """
        {% endfor %}
    {% elif CSET_CYCLING_MODE == "trial" %}
        {{CSET_TRIAL_CYCLE_PERIOD}} = """
                    {{metplus_grid_stat_graph()}}
                """
    {% endif %}
    R1/$ = """
        {% for model in models %}
            cycle_complete => verpy_metloader_grid_stat_m{{model["id"]}}
        {% endfor %}
        VERPY_METLOADER:succeed-all => verpy_plot_grid_stat => finish_website
        """

[runtime]
    [[METPLUS_GRID_STAT]]
        inherit = METPLUS
        [[[environment]]]
            ROSE_TASK_APP = metplus_grid_stat

    {% for model in models %}
    [[metplus_grid_stat_m{{model["id"]}}]]
    # Runs METplus wrappers for point stat calculations.
        inherit = METPLUS_GRID_STAT, METPLUS_M{{model["id"]}}

    [[metplus_grid_stat_postproc_m{{model["id"]}}]]
    # Archives grid stat results in tar files ready for verpy loading.
        inherit = METPLUS_POSTPROC, METPLUS_M{{model["id"]}}
        [[[environment]]]
            MET_TOOL = Grid_Stat

    [[verpy_metloader_grid_stat_m{{model["id"]}}]]
    # Runs VerPy metloader utility to create the VerPy databases
        inherit = VERPY_METLOADER, METPLUS_M{{model["id"]}}
        [[[environment]]]
            MET_TOOL = Grid_Stat
    {% endfor %}

    [[verpy_plot_grid_stat]]
    # Runs VerPy plotting routines
        inherit = VERPY_PLOT
        [[[environment]]]
            MET_TOOL = Grid_Stat

{% endif %}
