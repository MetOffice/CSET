{% if RUN_METPLUS_GRID_STAT|default(False) or RUN_METPLUS_POINT_STAT|default(False) or RUN_METPLUS_ENSEMBLE_STAT|default(False)%}
[runtime]

    [[METPLUS]]
        script = """
        rose task-run

        {% if METPLUS_VERIFY_PRECIP %} rose task-run --command-key=precip {% endif %}
        """
        [[[environment]]]
        # Next line is to provide compatibility with cylc versions before 8.5.1, where CYLC_WORKFLOW_SHARE_DIR does not yet exist
        CYLC_TASK_SHARE_CYCLE_DIR = {{CYLC_TASK_SHARE_CYCLE_DIR| default("${CYLC_WORKFLOW_SHARE_DIR}/cycle/${CYLC_TASK_CYCLE_POINT}")}}
        METPLUS_ANA_DIR = {{METPLUS_ANA_DIR}}
        METPLUS_FCST_DIR = {{METPLUS_FCST_DIR|default("$CYLC_TASK_SHARE_CYCLE_DIR/metplus_fcst")}}
        METPLUS_OBS_DIR = {{METPLUS_OBS_DIR|default("$CYLC_TASK_SHARE_CYCLE_DIR/metplus_obs")}}
        METPLUS_AREA_DIR = {{METPLUS_AREA_DIR}}
        METPLUS_STN_DIR = {{METPLUS_STN_DIR}}
        ROSE_APP_OPT_CONF_KEYS = ({{SITE}}) {{METPLUS_OPT_CONFIG_KEYS|default("")}}
        TASK_START_TIME = $(cylc cyclepoint --template CCYYMMDDThh)
        FORECAST_LENGTH = $(isodatetime --as-total H -- {{ANALYSIS_LENGTH}} | cut -d '.' -f 1 )
        TASK_END_TIME = $(cylc cyclepoint --offset {{ANALYSIS_LENGTH}} --template CCYYMMDDThh)

    [[VERPY_METLOADER]]
    # Family grouping for all VerPy metloader tasks
        inherit = METPLUS
        script = rose task-run -v --app-key=verpy_metloader

{% if METPLUS_VERIFY_PRECIP %}
    [[METPLUS]]
        [[[environment]]]
            METPLUS_VERIFY_PRECIP = TRUE
            METPLUS_PRECIP_FCST_VARIABLE = {{METPLUS_PRECIP_FCST_VARIABLE}}
            METPLUS_PRECIP_FCST_ACCUM = {{METPLUS_PRECIP_FCST_ACCUM | duration_as('h') | int}}
            # TODO: Allow for different FCST and OBS accums using PcpCombine
            METPLUS_PRECIP_OBS_ACCUM = {{METPLUS_PRECIP_FCST_ACCUM | duration_as('h') | int}}
{% endif %}

{% for model in models %}
    [[metplus_prep_fcst_m{{model["id"]}}]]
    # Prepares model data for use by metplus
        inherit = METPLUS
        [[[environment]]]
            ROSE_TASK_APP = metplus_prep_fcst
            MODEL_NAME = {{model["name"]}}
            MODEL_ID = m{{model["id"]}}
            INPUT_PATHS = $CYLC_TASK_SHARE_CYCLE_DIR/data/{{model["id"]}}
        {% if SELECT_SUBAREA %}
            SUBAREA_TYPE = {{SUBAREA_TYPE}}
            SUBAREA_EXTENT = {{SUBAREA_EXTENT}}
        {% else %}
            SUBAREA_TYPE = None
            SUBAREA_EXTENT = None
        {% endif %}
{% endfor %}

{% endif %}
