[VerPy_common]
comment = common defs
system = MET
truth = ["GPM", "Rainfields3"]
interp = NEAREST
param = ["APCP @ 3"]

[VerPyPlot_gs_precip_fs]
comment = gs_precip_fs
jobid = gs_precip_fs
inherit = VerPy_common
type = cnt
stats = ["ME (FcVsObs)", "MSE (FcVsObs)"]
output = fcrseries

[VerPyPlot_gs_precip_ts]
comment = gs_precip_ts
jobid = gs_precip_ts
inherit = VerPy_common
type = cnt
stats = ["ME (FcVsObs)", "MSE (FcVsObs)"]
output = timeseries
aggopts = fcrs

[VerPyPlot_gs_precip_di]
comment = gs_precip_di
jobid = gs_precip_di
inherit = VerPy_common
type = cnt
stats = ["ME (FcVsObs)", "MSE (FcVsObs)"]
output = diurnal
aggopts = fcrs

[VerPyPlot_gs_precip_nbr_fs]
comment = gs_precip_fs
jobid = gs_precip_fs
inherit = VerPy_common
type = nbrcnt
interp = NBRHD_SQUARE
scales = [1]
stats = ["FSS (FcVsObs)"]
output = fcrseries

[VerPyPlot_gs_precip_nbr_ts]
comment = gs_precip_ts
jobid = gs_precip_ts
inherit = VerPy_common
type = nbrcnt
interp = NBRHD_SQUARE
scales = [1]
stats = ["FSS (FcVsObs)"]
output = timeseries
aggopts = fcrs

[VerPyPlot_gs_precip_nbr_di]
comment = gs_precip_di
jobid = gs_precip_di
inherit = VerPy_common
type = nbrcnt
interp = NBRHD_SQUARE
scales = [1]
stats = ["FSS (FcVsObs)"]
output = diurnal
aggopts = fcrs

