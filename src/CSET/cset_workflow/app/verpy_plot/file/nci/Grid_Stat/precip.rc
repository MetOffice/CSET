[VerPyPlot_gs_precip_roebber]
comment = gs_precip_roebber
jobid = gs_precip_roebber
inherit = VerPy_common
type = ctc
stats = [7921, 7922, 7923]
interp = NEAREST
output = roebber
compare_on_plot = fcrs
fcrs = [600, 1200, 1800, 2400]
plottheme = split

