{% set PROJECT = PROJECT | default(environ['PROJECT']) %}
{% set VERPY_DIR = VERPY_DIR | default("/g/data/dp9/saw562/ver/verpy") %}
{% set CSET_MODULE_VERSION = "26.9.1" %}

# Site configuration for NCI Gadi
#
# Important rose-suite.conf settings:
#   SITE = "nci-gadi"   # Enable the site
#   PROJECT             # NCI project code
#   VERPY_DIR           # Path to Verpy source code
#   METPLUS_OBS_SYSTEM  # Where to source obs from
#                       # Can be a Bureau forecast system e.g.
#                       # 'access_c3_dn' or 'custom'
#   CUSTOM_ODB2_PATTERN # Path to custom ODB2 files if using
#                       # 'custom' system
#
#  Leave METPLUS_FCST_DIR and METPLUS_OBS_DIR unset

{% set ODB2_PATTERNS = {
    "access_c3_ad": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_ad_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c3_bn": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_bn_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c3_dn": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_dn_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c3_nq": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_nq_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c3_ph": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_ph_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c3_sy": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_sy_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c3_vt": "/g/data/ig2/odb2/access_c3/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_vt_odb2.tar.zst@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_ad": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_ad_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_bn": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_bn_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_dn": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_dn_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_nq": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_nq_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_ph": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_ph_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_sy": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_sy_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_c4_vt": "/g/data/ig2/odb2/access_c4/%Y/%m/%Y%m%dT%H%MZ/%Y%m%dT%H%MZ_vt_odb2.tgz@ukv_odb2/aircraftsondesurface.odb",
    "access_g4": "/g/data/ig2/odb2/access_g4/%Y/%m/%Y%m%dT%H%MZ/glm_odb2/surface.odb.zst",
    "custom": CUSTOM_ODB2_PATTERN | default("/dev/null"),
} %}

[runtime]
    [[root]]
        platform = gadi_background
        init-script = """
            module use /g/data/access/ngm/modules
            module load cset/{{CSET_MODULE_VERSION}}
            """
        [[[ environment ]]]
            PROJECT = {{ PROJECT }}
        {% if CSET_DIR is defined %}
            PYTHONPATH = {{CSET_DIR}}
        {% endif %}

{% if RUN_METPLUS_GRID_STAT|default(False) or RUN_METPLUS_POINT_STAT|default(False) %}
    [[METPLUS]]
        platform = gadi_pbs
        execution time limit = PT1H
        [[[ directives ]]]
            -P          = {{ PROJECT }}
            -q          = normal
            -l ncpus    = 12
            -l mem      = 48gb
            -l storage  = scratch/{{PROJECT}}+gdata/{{PROJECT}}+gdata/access+gdata/dp9+gdata/hr22+gdata/ig2+scratch/dx2
            -W umask    = 0022
        [[[ environment ]]]
            OMP_NUM_THREADS = $PBS_NCPUS
            ANALYSIS_LENGTH = {{ANALYSIS_LENGTH}}
            # Shift valid times in METplus by this many seconds
            METPLUS_FCST_SHIFT  = {{METPLUS_FCST_SHIFT | default(0)}}
            VERPY_DIR = {{VERPY_DIR}}
        {% if CSET_DIR is defined %}
            PYTHONPATH = {{CSET_DIR}}:{{VERPY_DIR}}
        {% else %}
            PYTHONPATH = {{VERPY_DIR}}
        {% endif %}
            ODB2_TEMPLATE = {{ODB2_PATTERNS[METPLUS_OBS_SYSTEM]}}
{% endif %}

    [[bake_recipes]]
        platform = gadi_pbs
        execution time limit = PT6H
        [[[ directives ]]]
            -P          = {{ PROJECT }}
            -q          = normal
            -l ncpus    = 48
            -l mem      = 180gb
            -l storage  = scratch/{{PROJECT}}+gdata/{{PROJECT}}+gdata/access+gdata/dp9+gdata/hr22+gdata/xp65+scratch/dx2
            -W umask    = 0022
        [[[ environment ]]]
            BUNCH_POOL_SIZE = $PBS_NCPUS

    [[bake_aggregation_recipes]]
        platform = gadi_pbs
        execution time limit = PT6H
        [[[ directives ]]]
            -P          = {{ PROJECT }}
            -q          = normal
            -l ncpus    = 48
            -l mem      = 180gb
            -l storage  = scratch/{{PROJECT}}+gdata/{{PROJECT}}+gdata/access+gdata/dp9+gdata/hr22+gdata/xp65+scratch/dx2
            -W umask    = 0022
        [[[ environment ]]]
            BUNCH_POOL_SIZE = $PBS_NCPUS
